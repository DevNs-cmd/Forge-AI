# ─────────────────────────────────────────────────────────────
# Forge-AI Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────
# Choose one: groq | gemini | openai
AI_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI or Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Service URLs ─────────────────────────────────────────────
# When running locally (outside Docker), use localhost
# When running in Docker, the compose file overrides this automatically
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── RazorpayX ──────────────────────────────────────────
# Get TEST keys from: https://x.razorpay.com/ → Settings → API Keys → Test Mode
# Test Key ID starts with: rzp_test_
# Test Key Secret: shown once on creation (save it!)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
